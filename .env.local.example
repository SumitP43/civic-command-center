# ============================================================
# AI Civic Command Center — Environment Configuration Template
# ============================================================
# Copy this file to .env.local and fill in the values.
# Real keys must be kept private and never committed to version control.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API
GEMINI_API_KEY=

# Optional Geocoding Service
GEOCODING_API_KEY=

# Optional SLA Cron Secret
CRON_SECRET=

# Application URLs & Metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Civic Command Center
